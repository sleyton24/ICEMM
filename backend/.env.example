# PostgreSQL connection string
DATABASE_URL="postgresql://icemm:STRONG_PASSWORD@localhost:5432/icemm?schema=public"

# Puerto del backend (Nginx hará proxy_pass desde /api/)
PORT=3001

# CORS origins (lista separada por coma). EN PRODUCCIÓN debe ser explícito:
# el backend aborta el arranque si NODE_ENV=production y CORS_ORIGIN está vacío o es "*".
# Ejemplo: CORS_ORIGIN=https://icemm.tudominio.com
CORS_ORIGIN=https://icemm.tudominio.com

# === BETA MODE ===
# true  → cualquiera con la URL usa la app SIN login y como admin. Solo QA/demo interna.
# false → requiere JWT (login real). OBLIGATORIO en producción.
# El backend aborta el arranque si NODE_ENV=production y BETA_MODE=true,
# salvo que se setee ALLOW_BETA_IN_PROD=true (opt-in consciente para demo interna).
BETA_MODE=false

# Secret para firmar JWT. OBLIGATORIO fuera de BETA y en prod: mínimo 32 chars,
# no puede ser este placeholder (el backend valida y aborta si no cumple).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-long-random-string

NODE_ENV=production
