# Modo demo: la app arranca con datos de ejemplo, sin login y sin backend.
#   npm run dev:demo    → http://localhost:5178
#
# Se usa para revisar y mostrar la herramienta sin credenciales de producción.
# El modo normal (npm run dev) no se ve afectado.
VITE_DEMO=true
VITE_API_URL=/api
VITE_FORCE_LOGIN_UI=false
